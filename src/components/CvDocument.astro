---
// Shared print-CV document. Rendered to a PDF via Playwright (see
// scripts/render-cv). Used by /cv (general) and /cv-python (role-tailored)
// so the template lives in ONE place — variants only differ by their data.
// Uses the FULL legal name in the header (employers verify against ID) with
// the brand in parentheses. noindex — this is a print source, not a site page.
const { cv, projects } = Astro.props;

const emailSet = !!cv.contact.email && !cv.contact.email.startsWith("TODO");
const contactBits = [
  emailSet ? cv.contact.email : null,
  cv.contact.website.replace("https://", ""),
  cv.contact.github.replace("https://", ""),
  cv.location,
].filter(Boolean);

// Client work awaiting the client's yes (`consentPending`) carries only an
// anonymised name in the data; the real one is never stored in this public repo.
// Full entries first; `cvCompact` ones become a one-line list so the PDF
// stays at two pages however much work is added.
const fullProjects = projects.filter((p) => !p.cvCompact);
const compactProjects = projects.filter((p) => p.cvCompact);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{cv.fullName} — CV</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --ink: #0b1020;
        --body: #1f2937;
        --muted: #6b7280;
        --line: #e2e2dd;
        --accent: #4338ca;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: "Inter", system-ui, sans-serif;
        color: var(--body);
        font-size: 9.5pt;
        line-height: 1.42;
      }
      .page { max-width: 780px; margin: 0 auto; padding: 36px 40px; }
      h1, h2, h3 { font-family: "Space Grotesk", sans-serif; color: var(--ink); margin: 0; letter-spacing: -0.01em; }
      .name { font-size: 23pt; line-height: 1.05; }
      .brand { color: var(--muted); font-weight: 500; font-size: 11.5pt; }
      .role { color: var(--accent); font-weight: 600; margin: 3px 0 0; font-size: 10.5pt; }
      .contact { color: var(--muted); font-size: 9pt; margin: 5px 0 0; }
      .contact span + span::before { content: "·"; margin: 0 8px; color: var(--line); }
      section { margin-top: 14px; }
      .label {
        font-size: 8pt; text-transform: uppercase; letter-spacing: 0.12em;
        color: var(--muted); border-bottom: 1px solid var(--line);
        padding-bottom: 3px; margin-bottom: 7px;
        break-after: avoid;
      }
      .summary { margin: 0; }
      .available { margin: 4px 0 0; color: var(--muted); font-size: 9pt; }
      .skills { display: grid; grid-template-columns: 1fr; gap: 1px; }
      .skills .row { display: flex; gap: 8px; }
      .skills .k { color: var(--ink); font-weight: 600; min-width: 104px; flex-shrink: 0; }
      .proj { margin-bottom: 8px; break-inside: avoid; }
      .proj-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
      .proj-name { font-size: 10.5pt; font-weight: 700; color: var(--ink); }
      .proj-meta { color: var(--muted); font-size: 8.5pt; white-space: nowrap; }
      .proj-role { color: var(--accent); font-weight: 600; font-size: 9pt; }
      .proj-delivery { color: var(--muted); font-weight: 400; }
      .proj-tag { margin: 1px 0 0; }
      .proj-stack { color: var(--muted); font-size: 8.5pt; margin: 1px 0 0; }
      .mini { margin-bottom: 3px; break-inside: avoid; }
      .mini-name { color: var(--ink); font-weight: 600; }
      .mini-meta { color: var(--muted); font-size: 8.5pt; }
      ul { margin: 2px 0 0; padding-left: 15px; }
      li { margin-bottom: 1px; }
      /* Page margins come from @page when printing, so page 2 gets a top
         margin too (with margin 0 its text ran to the paper's edge). */
      @page { size: A4; margin: 11mm 0; }
      @media print { .page { padding-top: 0; padding-bottom: 0; } }
    </style>
  </head>
  <body>
    <div class="page">
      <header>
        <h1 class="name">{cv.fullName} <span class="brand">({cv.brand})</span></h1>
        <p class="role">{cv.title}</p>
        <p class="contact">{contactBits.map((b) => <span>{b}</span>)}</p>
      </header>

      <section>
        <div class="label">Summary</div>
        <p class="summary">{cv.summary}</p>
        {cv.available && <p class="available">{cv.available}</p>}
      </section>

      <section>
        <div class="label">Skills</div>
        <div class="skills">
          {cv.skills.map((g) => (
            <div class="row">
              <span class="k">{g.group}</span>
              <span>{g.items.join(", ")}</span>
            </div>
          ))}
        </div>
      </section>

      <section>
        <div class="label">Selected projects</div>
        {fullProjects.map((p) => (
          <div class="proj">
            <div class="proj-head">
              <span>
                <span class="proj-name">{p.name}</span>
                <span class="proj-role">&nbsp; {p.role}{p.delivery && <span class="proj-delivery"> · {p.delivery}</span>}</span>
              </span>
              <span class="proj-meta">{p.year}</span>
            </div>
            <p class="proj-tag">{p.tagline}</p>
            <ul>
              {p.highlights.slice(0, 2).map((h) => <li>{h}</li>)}
            </ul>
            <p class="proj-stack">{p.stack.join(" · ")}</p>
          </div>
        ))}
      </section>

      {compactProjects.length > 0 && (
        <section>
          <div class="label">More projects</div>
          {compactProjects.map((p) => (
            <div class="mini">
              <span class="mini-name">{p.name}</span>
              <span class="mini-meta"> · {[p.delivery, p.year].filter(Boolean).join(" · ")}</span>
              <span> — {p.tagline}</span>
            </div>
          ))}
        </section>
      )}

      {cv.education?.length > 0 && (
        <section>
          <div class="label">Education & training</div>
          {cv.education.map((e) => (
            <div class="proj">
              <div class="proj-head">
                <span class="proj-name">{e.name}</span>
                <span class="proj-meta">{e.year}</span>
              </div>
              {e.detail && <p class="proj-tag">{e.detail}</p>}
            </div>
          ))}
        </section>
      )}
    </div>
  </body>
</html>
