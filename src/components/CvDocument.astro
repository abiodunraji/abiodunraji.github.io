---
// Shared print-CV document. Rendered to a PDF via Playwright (see
// scripts/render-cv). Used by /cv (general) and /cv-python (role-tailored)
// so the template lives in ONE place — variants only differ by their data.
// Uses the FULL legal name in the header (employers verify against ID) with
// the brand in parentheses. noindex — this is a print source, not a site page.
//
// THE LEDGER (Oct 2026): a CV where every claim carries its receipt. He builds
// record-keepers (Ajoko, the watchman, the truth gate), so the page reads like
// one: a receipts bar for the seven-second scan, and a proof column down the
// right of the work where each highlight shows the number that proves it. The
// receipts are only numbers already in his own data (cv.receipts, a project's
// `proof` keyed by highlight index). A project's live domain heads its proof
// column: the first receipt is that the thing exists. One page, real text in
// reading order (application software parses it), IBM Plex Sans + Plex Mono, one
// "pass" green.
const { cv, projects } = Astro.props;

const emailSet = !!cv.contact.email && !cv.contact.email.startsWith("TODO");
const contact = [
  emailSet ? { text: cv.contact.email, href: `mailto:${cv.contact.email}` } : null,
  { text: cv.contact.website.replace("https://", ""), href: cv.contact.website },
  { text: cv.contact.github.replace("https://", ""), href: cv.contact.github },
  cv.contact.linkedin ? { text: cv.contact.linkedin.replace("https://www.", "").replace(/\/$/, ""), href: cv.contact.linkedin } : null,
  { text: cv.location, href: null },
].filter(Boolean);

// Which highlights the one-page CV shows (`cvShow`, in order), each with its
// receipt if the data has one. Without `cvShow`, the first two, no receipts.
const rows = (p) =>
  (p.cvShow ?? [0, 1]).filter((i) => p.highlights[i]).map((i) => ({ text: p.highlights[i], proof: p.proof?.[String(i)] ?? null }));
// The live domain, or null for a project without one (url "private").
const host = (url) => (/^https?:\/\//.test(url ?? "") ? url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "") : null);

const fullProjects = projects.filter((p) => !p.cvCompact);
const compactProjects = projects.filter((p) => p.cvCompact);
const summary = cv.cvSummary ?? cv.summary;
const tagline = cv.cvTagline ?? cv.tagline; // "" hides it on the CV (the summary already says it)
// The stack line spans the full width and comes first: it is what application
// software matches on, and it is the longest group. Groups the data marks
// `cvWide` follow it at full width; the rest pair up in two columns.
const stackGroup = cv.skills.find((g) => /stack/i.test(g.group));
const isWide = (g) => g === stackGroup || !!g.cvWide;
const skillsOrdered = [stackGroup, ...cv.skills.filter((g) => g.cvWide && g !== stackGroup), ...cv.skills.filter((g) => !isWide(g))].filter(Boolean);
const available = cv.cvAvailable ?? cv.available;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{cv.fullName} — CV</title>
    <style>
      /* Static IBM Plex, self-hosted (public/fonts/ibm-plex, SIL OFL). Google
         serves Plex Sans only as a variable font, and Chrome prints a variable
         font into the PDF as Type3 glyph drawings, which some application
         software reads badly; static files embed as real fonts. IBM's files also
         carry the → that Google's latin subset lacks. */
      @font-face { font-family: "IBM Plex Sans"; src: url("/fonts/ibm-plex/IBMPlexSans-Regular.woff2") format("woff2"); font-weight: 400; font-display: block; }
      @font-face { font-family: "IBM Plex Sans"; src: url("/fonts/ibm-plex/IBMPlexSans-Medium.woff2") format("woff2"); font-weight: 500; font-display: block; }
      @font-face { font-family: "IBM Plex Sans"; src: url("/fonts/ibm-plex/IBMPlexSans-SemiBold.woff2") format("woff2"); font-weight: 600; font-display: block; }
      @font-face { font-family: "IBM Plex Sans"; src: url("/fonts/ibm-plex/IBMPlexSans-Bold.woff2") format("woff2"); font-weight: 700; font-display: block; }
      @font-face { font-family: "IBM Plex Mono"; src: url("/fonts/ibm-plex/IBMPlexMono-Regular.woff2") format("woff2"); font-weight: 400; font-display: block; }
      @font-face { font-family: "IBM Plex Mono"; src: url("/fonts/ibm-plex/IBMPlexMono-Medium.woff2") format("woff2"); font-weight: 500; font-display: block; }
      @font-face { font-family: "IBM Plex Mono"; src: url("/fonts/ibm-plex/IBMPlexMono-SemiBold.woff2") format("woff2"); font-weight: 600; font-display: block; }
      :root {
        --ink: #111418;
        --body: #272c32;
        --muted: #5d6670;
        --faint: #8b939b;
        --line: #dfe3e6;
        --rule: #111418;
        --proof: #0d7a50; /* the colour of a passing test: used ONLY on proof */
        --sans: "IBM Plex Sans", system-ui, sans-serif;
        --mono: "IBM Plex Mono", ui-monospace, monospace;
        --gutter: 25mm; /* the ledger's index column */
        --proofcol: 39mm; /* the ledger's proof column */
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: #fff; }
      body { font-family: var(--sans); color: var(--body); font-size: 8.5pt; line-height: 1.34; text-wrap: pretty; -webkit-font-smoothing: antialiased; }
      a { color: inherit; text-decoration: none; }
      /* 296mm, not 297: a page box exactly A4-tall rounds over by a sliver and
         Chrome then prints the footer alone on a second page. */
      .page { width: 210mm; min-height: 296mm; margin: 0 auto; padding: 9.5mm 14mm 9mm; display: flex; flex-direction: column; }

      /* ---- who ---- */
      .top { display: grid; grid-template-columns: 1fr auto; gap: 8mm; align-items: end; padding-bottom: 4.2mm; }
      .name { font-size: 24pt; font-weight: 600; letter-spacing: -0.02em; line-height: 1.02; color: var(--ink); margin: 0; }
      .brand { font-size: 12pt; font-weight: 400; letter-spacing: 0; color: var(--muted); }
      .role { margin: 2.2mm 0 0; font-size: 11.5pt; font-weight: 600; color: var(--ink); letter-spacing: -0.005em; }
      .tagline { margin: 1mm 0 0; font-size: 9pt; color: var(--muted); max-width: 120mm; }
      .avail { margin: 1.4mm 0 0; font-size: 8.2pt; line-height: 1.38; color: var(--muted); max-width: 112mm; }
      .contact { list-style: none; margin: 0; padding: 0; text-align: right; font-family: var(--mono); font-size: 7.6pt; line-height: 1.55; color: var(--body); }

      /* ---- the receipts bar: the seven-second scan ---- */
      .receipts { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1.4pt solid var(--rule); border-bottom: 0.6pt solid var(--line); margin: 0 0 4.4mm; }
      .receipt { padding: 2.6mm 3mm 2.8mm 0; }
      .receipt + .receipt { padding-left: 3.2mm; border-left: 0.6pt solid var(--line); }
      .rv { font-family: var(--mono); font-weight: 600; font-size: 16.5pt; line-height: 1.05; color: var(--proof); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
      .ru { font-family: var(--mono); font-size: 8pt; font-weight: 500; color: var(--proof); margin-left: 1mm; letter-spacing: 0; }
      .rl { margin: 1.2mm 0 0; font-size: 7.6pt; line-height: 1.32; word-spacing: 0.05em; color: var(--muted); }

      /* ---- the ledger: index column + body ---- */
      .row { display: grid; grid-template-columns: var(--gutter) 1fr; gap: 0 4mm; padding: 1.8mm 0; border-top: 0.6pt solid var(--line); break-inside: avoid; }
      .idx { font-family: var(--mono); font-size: 6.9pt; font-weight: 500; text-transform: uppercase; letter-spacing: 0.14em; color: var(--faint); padding-top: 0.6mm; }
      .summary { margin: 0; font-size: 9pt; color: var(--body); }

      .proj { break-inside: avoid; }
      .proj + .proj { margin-top: 3mm; }
      .ph { display: grid; grid-template-columns: 1fr var(--proofcol); align-items: baseline; }
      .pn { font-size: 10pt; font-weight: 600; color: var(--ink); letter-spacing: -0.005em; }
      .pr { font-size: 8pt; color: var(--muted); margin-left: 1.6mm; }
      .py { font-family: var(--mono); font-size: 7.4pt; color: var(--faint); padding-left: 3mm; }
      /* One continuous rule per project, tagline to last line, so each proof can
         sit on its own line's baseline (a border on every cell breaks wherever a
         cell is shorter than its row). */
      .ledger { position: relative; margin-top: 0.4mm; }
      .ledger::after { content: ""; position: absolute; top: 0; bottom: 0; right: var(--proofcol); border-left: 0.6pt solid var(--line); }
      .pt, .lines li { display: grid; grid-template-columns: 1fr var(--proofcol); align-items: baseline; }
      .pt { margin: 0 0 0.8mm; }
      .pt .t0 { padding-right: 3mm; color: var(--body); }
      .lines { list-style: none; margin: 0; padding: 0; }
      .lines .t { position: relative; padding: 0.35mm 3mm 0.35mm 3mm; color: var(--body); }
      .lines .t::before { content: ""; position: absolute; left: 0.4mm; top: 2.15mm; width: 1.1mm; height: 0.6pt; background: var(--faint); }
      .p { padding: 0.35mm 0 0.35mm 3mm; font-family: var(--mono); font-size: 7.4pt; font-weight: 600; color: var(--proof); font-variant-numeric: tabular-nums; white-space: nowrap; }
      .pt .p { padding-top: 0; padding-bottom: 0; font-weight: 500; }
      .stack { margin: 0.8mm 0 0; padding-right: var(--proofcol); font-family: var(--mono); font-size: 6.9pt; color: var(--muted); letter-spacing: 0.01em; }
      .stack .note { color: var(--faint); }
      /* Lists break between items, never inside one ("GitHub / Pages"). */
      .si { white-space: nowrap; }

      .mini { margin-top: 1mm; }
      .mini-name { color: var(--ink); font-weight: 600; }

      .skills { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2mm 6mm; }
      .skills > div { font-size: 8pt; color: var(--body); }
      .skills > .wide { grid-column: 1 / -1; }
      .sk-k { font-weight: 600; color: var(--ink); margin-right: 1.2mm; }

      .edu { display: grid; grid-template-columns: 1fr auto; gap: 0.6mm 4mm; }
      .en { font-weight: 600; color: var(--ink); }
      .ey { font-family: var(--mono); font-size: 7.4pt; color: var(--faint); text-align: right; }
      .ed { grid-column: 1 / -1; margin: 0 0 1.2mm; color: var(--muted); font-size: 8pt; }

      .foot { margin-top: auto; padding-top: 2.4mm; border-top: 1.4pt solid var(--rule); }
      .foot .sig { font-family: var(--mono); font-size: 7.4pt; font-weight: 500; color: var(--proof); }

      @page { size: A4; margin: 0; }
      @media print { .page { margin: 0; } }
    </style>
  </head>
  <body>
    <div class="page">
      <header class="top">
        <div>
          <h1 class="name">{cv.fullName} <span class="brand">({cv.brand})</span></h1>
          <p class="role">{cv.title}</p>
          {tagline && <p class="tagline">{tagline}</p>}
          {available && <p class="avail">{available}</p>}
        </div>
        <ul class="contact">
          {contact.map((c) => <li>{c.href ? <a href={c.href}>{c.text}</a> : c.text}</li>)}
        </ul>
      </header>

      {cv.receipts?.length > 0 && (
        <section class="receipts" aria-label="Receipts">
          {cv.receipts.map((r) => (
            <div class="receipt">
              <div><span class="rv">{r.value}</span>{r.unit && <span class="ru">{r.unit}</span>}</div>
              <p class="rl">{r.label}</p>
            </div>
          ))}
        </section>
      )}

      <section class="row">
        <div class="idx">Summary</div>
        <p class="summary">{summary}</p>
      </section>

      <section class="row">
        <div class="idx">Selected work</div>
        <div>
          {fullProjects.map((p) => (
            <article class="proj">
              <div class="ph">
                <div><span class="pn">{p.name}</span><span class="pr">{p.role}{p.delivery && ` · ${p.delivery}`}</span></div>
                <div class="py">{p.year}</div>
              </div>
              <div class="ledger">
                <p class="pt"><span class="t0">{p.tagline}</span><span class="p">{host(p.url) && <a href={p.url}>{host(p.url)}</a>}</span></p>
                <ul class="lines">
                  {rows(p).map((r) => (
                    <li><span class="t">{r.text}</span><span class="p">{r.proof ?? ""}</span></li>
                  ))}
                </ul>
              </div>
              <p class="stack">{p.stack.map((s, i) => <>{i > 0 && " · "}<span class="si">{s}</span></>)}{p.cvStackNote && <> · <span class="si note">{p.cvStackNote}</span></>}</p>
            </article>
          ))}
          {compactProjects.map((p) => (
            <div class="mini"><span class="mini-name">{p.name}</span> · {[p.delivery, p.year].filter(Boolean).join(" · ")} — {p.tagline}</div>
          ))}
        </div>
      </section>

      <section class="row">
        <div class="idx">Skills</div>
        <div class="skills">
          {skillsOrdered.map((g) => (
            <div class={isWide(g) ? "wide" : undefined}><span class="sk-k">{g.group}</span>{g.items.map((it, i) => <>{i > 0 && ", "}<span class="si">{it}</span></>)}</div>
          ))}
        </div>
      </section>

      {cv.education?.length > 0 && (
        <section class="row">
          <div class="idx">Education</div>
          <div class="edu">
            {cv.education.map((e) => (
              <>
                <span class="en">{e.name}</span>
                <span class="ey">{e.year}</span>
                {(e.cvDetail ?? e.detail) && !e.cvHideDetail && <p class="ed">{e.cvDetail ?? e.detail}</p>}
              </>
            ))}
          </div>
        </section>
      )}

      {cv.cvSignature && (
        <footer class="foot">
          <span class="sig">{cv.cvSignature}</span>
        </footer>
      )}
    </div>
  </body>
</html>
