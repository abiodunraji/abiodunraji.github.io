---
// Role-tailored print CV for Python / FastAPI / AI roles → rendered to
// /cv-python.pdf (see scripts/render-cv). Reuses the shared CvDocument template
// with Python-slanted data (cv.python.json) and a Dreamy-first project order
// (the FastAPI/LLM flagship leads). The shared projects.json is left untouched.
import cv from "../data/cv.python.json";
import allProjects from "../data/projects.json";
import CvDocument from "../components/CvDocument.astro";

const order = ["dreamy", "healthbrew", "ajoko", "marcplaats", "house-of-faridah"];
const rank = (p) => {
  const i = order.indexOf(p.slug);
  return i === -1 ? order.length : i;
};
const projects = [...allProjects].sort((a, b) => rank(a) - rank(b));
---

<CvDocument cv={cv} projects={projects} />
