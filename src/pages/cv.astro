---
// General print CV → rendered to /cv.pdf (see scripts/render-cv). The document
// template lives in components/CvDocument.astro; this page just supplies the
// general-purpose data. Role-tailored variants (e.g. /cv-python) reuse the same
// component with different data.
import cv from "../data/cv.json";
import projects from "../data/projects.json";
import CvDocument from "../components/CvDocument.astro";
---

<CvDocument cv={cv} projects={projects} />
