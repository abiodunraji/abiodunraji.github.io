---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import projects from "../data/projects.json";
---

<Base title="Work" description="Client projects and my own products — platforms, stores, sites, search work and AI systems.">
  <section class="mx-auto max-w-5xl px-6 pt-20 pb-4">
    <h1 class="reveal text-4xl font-bold sm:text-5xl">Work</h1>
    <p class="reveal mt-4 max-w-2xl text-lg text-[var(--color-body)]" data-d="1">
      Client projects and my own products: live platforms, stores, sites, search
      work and AI systems, plus a few built and not yet launched. Each card says
      which. Some clients are described rather than named until they say yes.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-6">
    <div class="grid gap-6 sm:grid-cols-2">
      {projects.map((project) => (
        <div class="reveal">
          <ProjectCard project={project} />
        </div>
      ))}
    </div>
  </section>
</Base>
